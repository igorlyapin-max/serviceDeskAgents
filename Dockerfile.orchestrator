FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY apps ./apps
COPY contracts ./contracts
COPY infra ./infra

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -e .

EXPOSE 18088

CMD ["python", "-m", "uvicorn", "apps.orchestrator.app.main:app", "--host", "0.0.0.0", "--port", "18088"]
