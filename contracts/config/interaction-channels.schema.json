{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servicedeskagents.local/contracts/config/interaction-channels.schema.json",
  "title": "Interaction Channels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "display_name",
          "mode",
          "description",
          "waiting_policy",
          "enabled"
        ],
        "properties": {
          "channel_id": {
            "$ref": "#/$defs/id"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "mode": {
            "type": "string",
            "enum": [
              "online_interactive",
              "offline_interactive",
              "debug"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "capabilities": {
            "$ref": "#/$defs/channel_capabilities"
          },
          "technical_profile": {
            "$ref": "#/$defs/channel_technical_profile"
          },
          "channel_parameters": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/channel_parameter"
            }
          },
          "waiting_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "first_reminder_after_seconds",
              "discussion_timeout_seconds",
              "sla_elapsed_percent_threshold",
              "on_no_answer",
              "auto_close_requires_client_confirmation",
              "pause_sla_on_client_wait",
              "client_wait_auto_close_after_hours"
            ],
            "properties": {
              "first_reminder_after_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 604800
              },
              "discussion_timeout_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 604800
              },
              "sla_elapsed_percent_threshold": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "on_no_answer": {
                "type": "string",
                "enum": [
                  "save_context",
                  "create_draft",
                  "create_work_order",
                  "call_specialist",
                  "debug_stop"
                ]
              },
              "auto_close_requires_client_confirmation": {
                "type": "boolean"
              },
              "pause_sla_on_client_wait": {
                "type": "boolean"
              },
              "client_wait_auto_close_after_hours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 168
              }
            }
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "channel_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supports_client_questions",
        "supports_operator_questions",
        "supports_work_order_creation",
        "supports_async_result"
      ],
      "properties": {
        "supports_client_questions": {
          "type": "boolean"
        },
        "supports_operator_questions": {
          "type": "boolean"
        },
        "supports_work_order_creation": {
          "type": "boolean"
        },
        "supports_async_result": {
          "type": "boolean"
        }
      }
    },
    "channel_technical_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport"
      ],
      "properties": {
        "transport": {
          "type": "string",
          "enum": [
            "none",
            "kafka"
          ]
        },
        "endpoint_id": {
          "$ref": "#/$defs/id"
        },
        "agent_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "task_topic_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "task_topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "result_topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "invalid_topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "temp_password_topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "message_key_parameter": {
          "$ref": "#/$defs/id"
        },
        "hmac_required": {
          "type": "boolean"
        }
      }
    },
    "channel_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "display_name",
        "direction",
        "source",
        "description"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "direction": {
          "type": "string",
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "secret": {
          "type": "boolean"
        }
      }
    }
  }
}
